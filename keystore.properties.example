# Template for release signing. Copy to keystore.properties (gitignored) and fill in.
# Generate the keystore ONCE with:
#   keytool -genkey -v -keystore release.keystore -keyalg RSA -keysize 2048 -validity 10000 -alias saavdhan
# Back up release.keystore + these passwords somewhere safe (NOT in this repo).
# Losing the keystore means you can never update the app for existing users.
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=saavdhan
keyPassword=CHANGE_ME
